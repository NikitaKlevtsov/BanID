<Window x:Class="BanID.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="BanID - Вход" Height="400" Width="450" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Вход" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Логин" Margin="0,10,0,5"/>
            <TextBox x:Name="txtLogin"/>
            <TextBlock Text="Пароль" Margin="0,10,0,5"/>
            <PasswordBox x:Name="txtPassword"/>
            <TextBlock Text="Капча" Margin="0,10,0,5"/>
            <StackPanel Orientation="Horizontal">
                <TextBlock x:Name="lblCaptcha" FontSize="20" FontWeight="Bold" Background="LightGray" Padding="10" Margin="0,0,10,0"/>
                <TextBox x:Name="txtCaptcha" Width="150"/>
            </StackPanel>
            <Button x:Name="btnLogin" Content="Войти" Height="35" Background="#1a1a1a" Foreground="White" Margin="0,20,0,10" Click="BtnLogin_Click"/>
            <Button x:Name="btnRegister" Content="Регистрация" Click="BtnRegister_Click"/>
            <TextBlock x:Name="tbError" Foreground="Red" Margin="0,10"/>
        </StackPanel>
    </Grid>
</Window>