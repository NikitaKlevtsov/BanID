<Window x:Class="BanID.CabinetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Личный кабинет" Height="500" Width="700" WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <GroupBox Header="Мои данные" Margin="0,0,0,15">
            <StackPanel>
                <TextBlock Text="ФИО:" FontWeight="Bold"/>
                <TextBox x:Name="txtFullName" IsReadOnly="True" Background="#F0F0F0"/>
                <TextBlock Text="Паспорт:" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBox x:Name="txtPassport" IsReadOnly="True" Background="#F0F0F0"/>
                <TextBlock Text="Адрес:" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBox x:Name="txtAddress" IsReadOnly="True" Background="#F0F0F0"/>
                <TextBlock Text="Телефон:" FontWeight="Bold" Margin="0,10,0,0"/>
                <TextBox x:Name="txtPhone" IsReadOnly="True" Background="#F0F0F0"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Мои счета" Grid.Row="1" Margin="0,0,0,15">
            <StackPanel>
                <ListBox x:Name="lstAccounts" DisplayMemberPath="AccountNumber" Height="120" Margin="0,5,0,5"/>
                <Button x:Name="btnStatement" Content="Выписка" Click="BtnStatement_Click" Width="150"/>
            </StackPanel>
        </GroupBox>
        <GroupBox Header="Действия" Grid.Row="2">
            <StackPanel>
                <Button x:Name="btnNewRequest" Content="Создать заявку" Click="BtnNewRequest_Click" Width="150" Margin="0,5"/>
                <Button x:Name="btnLogout" Content="Выйти" Click="BtnLogout_Click" Width="150" Margin="0,5" Background="Gray"/>
            </StackPanel>
        </GroupBox>
    </Grid>
</Window>