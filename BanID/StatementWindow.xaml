<Window x:Class="BanID.StatementWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Выписка" Height="450" Width="700" WindowStartupLocation="CenterOwner">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
            <TextBlock Text="От:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpStart" Margin="0,0,15,0"/>
            <TextBlock Text="До:" VerticalAlignment="Center" Margin="0,0,5,0"/>
            <DatePicker x:Name="dpEnd" Margin="0,0,15,0"/>
            <Button x:Name="btnGenerate" Content="Показать" Click="BtnGenerate_Click" Margin="0,0,15,0" Width="100"/>
            <Button x:Name="btnSaveTxt" Content="Сохранить в TXT" Click="BtnSaveTxt_Click" Width="120"/>
        </StackPanel>
        <DataGrid x:Name="dgTransactions" Grid.Row="1" AutoGenerateColumns="True" Margin="0,0,0,10"/>
        <TextBlock x:Name="tbTotal" Grid.Row="2" FontWeight="Bold"/>
    </Grid>
</Window>