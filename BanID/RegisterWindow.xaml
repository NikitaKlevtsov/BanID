<Window x:Class="BanID.RegisterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Регистрация" Height="550" Width="450" WindowStartupLocation="CenterOwner">
    <Grid Margin="20">
        <StackPanel>
            <TextBlock Text="Регистрация" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center"/>
            <TextBlock Text="Логин" Margin="0,10,0,5"/>
            <TextBox x:Name="txtLogin"/>
            <TextBlock Text="Пароль" Margin="0,10,0,5"/>
            <PasswordBox x:Name="txtPassword"/>
            <TextBlock Text="Повторите пароль" Margin="0,10,0,5"/>
            <PasswordBox x:Name="txtPasswordConfirm"/>
            <TextBlock Text="ФИО" Margin="0,10,0,5"/>
            <TextBox x:Name="txtFullName"/>
            <TextBlock Text="Паспорт" Margin="0,10,0,5"/>
            <TextBox x:Name="txtPassport"/>
            <TextBlock Text="Адрес" Margin="0,10,0,5"/>
            <TextBox x:Name="txtAddress"/>
            <TextBlock Text="Телефон" Margin="0,10,0,5"/>
            <TextBox x:Name="txtPhone"/>
            <Button x:Name="btnRegister" Content="Зарегистрироваться" Height="35" Background="#1a1a1a" Foreground="White" Margin="0,20,0,10" Click="BtnRegister_Click"/>
            <TextBlock x:Name="tbError" Foreground="Red"/>
        </StackPanel>
    </Grid>
</Window>